{
  "manifest_version": 3,
  "name": "Domain Guard",
  "version": "1.0.0",
  "description": "Blocks selected domains and asks for confirmation before continuing.",

  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "action": {
    "default_title": "Domain Guard"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
