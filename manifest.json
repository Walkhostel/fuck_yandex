{
  "manifest_version": 3,
  "name": "Fuck Yandex",
  "version": "1.0.0",
  "description": "Blocks all Yandex domains",

  "browser_specific_settings": {
    "gecko": {
      "id": "fuck-yandex@walkhostel",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "action": {
    "default_title": "Fuck Yandex"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
